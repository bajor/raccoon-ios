{
  "name": "raccoon-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --base=./ && node scripts/build-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "node scripts/patch-playwright.mjs",
    "test": "playwright test",
    "check": "npm run build && npm test && node scripts/lint-docs.mjs && git diff --check HEAD"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": {
    "@playwright/test": "1.64.1", "@types/node": "^22", "typescript": "7.0.2", "vite": "8.3.4",
    "yaml": "^2.8.0", "marked": "18.1.1"
  }
}
